# Base URL of the Laravel backend. The public API lives under /api/v1.
# Inlined at build time, so rebuild after changing it.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Public URL of this site, for canonical links, Open Graph URLs, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional static-export settings for a site hosted below a domain path.
# Example: STATIC_EXPORT=true and NEXT_PUBLIC_BASE_PATH=/demo/mrtree.
STATIC_EXPORT=false
NEXT_PUBLIC_BASE_PATH=

# Optional same-origin PHP endpoint used only for contact enquiries when the Laravel API
# is unavailable on static hosting. Other writes still require NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Server-only key matching the backend's FRONTEND_API_KEY, so page rendering is not
# rate limited as a single visitor. Never prefix it with NEXT_PUBLIC_.
FRONTEND_API_KEY=
