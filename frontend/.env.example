# Base URL of the Laravel backend. The public API lives under /api/v1.
# Inlined at build time, so rebuild after changing it.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Public URL of this site, for canonical links, Open Graph URLs, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only key matching the backend's FRONTEND_API_KEY, so page rendering is not
# rate limited as a single visitor. Never prefix it with NEXT_PUBLIC_.
FRONTEND_API_KEY=
